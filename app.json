{
  "expo": {
    "name": "Hidden Tanuki",
    "slug": "hidden-tanuki",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "hiddentanuki",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "bundleIdentifier": "com.sugistar.hiddentanuki",
      "supportsTablet": true
    },
    "android": {
      "package": "com.sugistar.hiddentanuki",
      "edgeToEdgeEnabled": true
    },
    "plugins": [
      "expo-router",
      "expo-audio",
      "expo-sqlite",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
